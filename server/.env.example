# pinka MCP — lokalni stdio server. Kopiraj u .env (gitignored) i popuni.

# Backend (dijeljeni self-hosted Supabase)
SUPABASE_URL=https://api.domovina.ai

# GOD-MODE ključ — zaobilazi RLS i KYC. SAMO lokalno; NIKAD u repo/log/remote.
# Izvor: domovina-api/.local-secrets.env (SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SERVICE_ROLE_KEY=

# Pinka account na koji se kampanje stvaraju (default = gmail personal account,
# dashboard-vidljiv). Promijeni samo ako znaš što radiš (identity mismatch zamka).
PINKA_ACCOUNT_ID=6a9bc134-9a03-435c-a7f7-7ecc324e0393

# Destinacija (Safe). Postavi BAR JEDNO:
#   - PINKA_OWNER_SIGNER: 0x signer → per-kampanja counterfactual Safe (kao web).
#     ⚠️ sredstva su povrativa samo ako relay može potpisati za taj signer.
#   - PINKA_DEFAULT_DESTINATION: 0x Safe koji SIGURNO kontroliraš (fallback).
# PINKA_OWNER_SIGNER=0x...
# PINKA_DEFAULT_DESTINATION=0x...

# Gnosis RPC (read-only, Safe predikcija)
GNOSIS_RPC=https://rpc.gnosischain.com
